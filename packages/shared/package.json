{
  "name": "@tally-trace/shared",
  "private": true,
  "version": "0.1.0",
  "description": "Shared types, utilities, and API client for Tally & Trace",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "pnpm run test:manila && pnpm run test:la",
    "test:manila": "TZ=Asia/Manila vitest run --exclude '**/*.la.test.ts'",
    "test:la": "TZ=America/Los_Angeles vitest run src/utils/loggedDays.la.test.ts src/utils/upcomingWindow.la.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "vitest": "^2.1.9"
  }
}
